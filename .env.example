# 复制为 .env.local（本地开发用）；部署到 Vercel 时，在
# Vercel → Settings → Environment Variables 配同名变量（勾选 Production/Preview/Development）。
# ⚠️ .env.local 已被 .gitignore 忽略，不会随 git push 上传，所以线上必须单独配置。

# 数据模式：supabase = 云端共享；local = 浏览器本地存储
NEXT_PUBLIC_DATA_MODE=supabase

# Supabase 公网信息（可在浏览器暴露）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# 仅服务端使用的后台写库密钥（Vercel 里类型选 Secret，切勿暴露到浏览器）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# 后台登录密码（服务端校验，Vercel 里类型选 Secret）
ADMIN_PASSWORD=change-me-to-a-strong-password
